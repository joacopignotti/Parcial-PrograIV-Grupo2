{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src"   // 👈 clave: carpeta fuente principal
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
